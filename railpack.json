{
  "providers": ["python", "node"],
  "install": {
    "cmds": [
      "pip3 install -r backend/requirements.txt",
      "cd frontend && npm ci"
    ]
  },
  "build": {
    "cmds": [
      "cd frontend && npm run build"
    ]
  },
  "start": {
    "cmd": "cd backend && python3 seed.py && uvicorn main:app --host 0.0.0.0 --port $PORT"
  }
}
